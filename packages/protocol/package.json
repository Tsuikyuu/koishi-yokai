{
  "name": "yokai-protocol",
  "description": "Vendor-neutral extension contracts for Yokai",
  "version": "0.0.1",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.js",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "sideEffects": false,
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false",
    "typecheck:test": "tsc --project test/tsconfig.json --pretty false"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "effect": "4.0.0-rc.110"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.110",
    "typescript": "^5.6.2",
    "vitest": "4.1.11"
  }
}
