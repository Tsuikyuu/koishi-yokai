{
  "name": "@root/yokai",
  "version": "0.0.0",
  "packageManager": "yarn@4.1.0",
  "private": true,
  "workspaces": [
    "external/*",
    "external/*/external/*",
    "external/*/packages/*",
    "external/*/plugins/*",
    "packages/*",
    "plugins/*"
  ],
  "license": "MIT",
  "scripts": {
    "build": "yakumo build",
    "bump": "yakumo version",
    "dep": "yakumo upgrade",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "lint:code": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix && prettier --write .",
    "pub": "yakumo publish",
    "test": "vitest run",
    "typecheck": "yarn typecheck:source && yarn typecheck:test",
    "typecheck:source": "yarn workspaces foreach -A --include '@yokai-internal/*' --include 'yokai-*' --include 'koishi-plugin-yokai*' run typecheck",
    "typecheck:test": "yarn workspaces foreach -A --include '@yokai-internal/*' --include 'yokai-*' --include 'koishi-plugin-yokai*' run typecheck:test",
    "check": "yarn typecheck && yarn lint && yarn test && yarn build"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.110",
    "@eslint/js": "^10.0.1",
    "@koishijs/client": "^5.30.4",
    "@koishijs/plugin-hmr": "^1.2.9",
    "@koishijs/scripts": "^4.6.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.2.70",
    "cross-env": "^7.0.3",
    "effect": "4.0.0-rc.110",
    "esbuild": "^0.23.1",
    "esbuild-register": "npm:@shigma/esbuild-register@^1.1.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "koishi": "^4.18.7",
    "prettier": "^3.9.6",
    "tsx": "^4.16.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.11",
    "yakumo": "^1.0.0-beta.21",
    "yakumo-esbuild": "^1.0.0-beta.7",
    "yakumo-tsc": "^1.0.0-beta.5",
    "yml-register": "^1.2.5"
  }
}
